<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
	</ItemGroup>

	<!-- Copy the Vite build (frontend/dist) into wwwroot during publish -->
	<ItemGroup>
		<!-- Path is from backend/Sneemy.API/ to frontend/dist -->
		<SpaFiles Include="..\..\frontend\dist\**\*" />
	</ItemGroup>

	<Target Name="CopySpaOnPublish" AfterTargets="Publish">
		<!-- Clean previous wwwroot in the publish directory -->
		<RemoveDir Directories="$(PublishDir)wwwroot" />
		<!-- Copy SPA files -->
		<Copy SourceFiles="@(SpaFiles)"
			  DestinationFolder="$(PublishDir)wwwroot\%(RecursiveDir)" />
	</Target>

</Project>
